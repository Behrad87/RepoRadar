<ui:FluentWindow x:Class="RepoRadar.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:RepoRadar.App.ViewModels"
        xmlns:conv="clr-namespace:RepoRadar.App.Converters"
        mc:Ignorable="d"
        Title="RepoRadar — Local Git Workspace Dashboard"
        Height="720" Width="1120"
        MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon.ico">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:IntToVisibilityConverter x:Key="IntToVis" />
        <conv:NonEmptyStringToVisibilityConverter x:Key="StringNotEmptyToVis" />
        <conv:DirtyStateToBorderBrushConverter x:Key="DirtyToBrush" />

        <Style x:Key="StatPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="#0B0F19">
        <Grid.RowDefinitions>
            <!-- Native Title Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- WINDOW TITLEBAR -->
        <ui:TitleBar Grid.Row="0" Title="RepoRadar — Local Git Workspace Dashboard" Icon="pack://application:,,,/Assets/icon.png" />

        <!-- MAIN DASHBOARD CONTENT -->
        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.RowDefinitions>
                <!-- Header Stats Cards -->
                <RowDefinition Height="Auto" />
                <!-- Filter & Search Toolbar -->
                <RowDefinition Height="Auto" />
                <!-- Repositories List / Empty State -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. HEADER & METRICS -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border CornerRadius="10" Width="44" Height="44" Margin="0,0,14,0" Background="#111827" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/icon.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="RepoRadar" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Local Git Workspace Monitor &amp; Workday Protector" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Metric Summary Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Total Repos -->
                    <Border Style="{StaticResource StatPill}" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding TotalReposCount, StringFormat='{}{0} Repos'}" FontWeight="Bold" Foreground="#E2E8F0" FontSize="13" />
                                <TextBlock Text="Monitored" FontSize="10" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Dirty Repos -->
                    <Border Style="{StaticResource StatPill}" Background="#3D1A04" BorderBrush="#F59E0B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding DirtyReposCount, StringFormat='{}{0} Dirty'}" FontWeight="Bold" Foreground="#FBBF24" FontSize="13" />
                                <TextBlock Text="Require Action" FontSize="10" Foreground="#FCD34D" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Unpushed Commits -->
                    <Border Style="{StaticResource StatPill}" Background="#0C364D" BorderBrush="#06B6D4" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬆️" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding TotalUnpushedCount, StringFormat='{}{0} Unpushed'}" FontWeight="Bold" Foreground="#67E8F9" FontSize="13" />
                                <TextBlock Text="Ahead of Remote" FontSize="10" Foreground="#A5F3FC" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Uncommitted Changes -->
                    <Border Style="{StaticResource StatPill}" Background="#3E0F23" BorderBrush="#F43F5E" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding TotalUncommittedCount, StringFormat='{}{0} Modified'}" FontWeight="Bold" Foreground="#FDA4AF" FontSize="13" />
                                <TextBlock Text="Uncommitted" FontSize="10" Foreground="#FECDD3" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Stashes -->
                    <Border Style="{StaticResource StatPill}" Background="#2E1065" BorderBrush="#A855F7" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding TotalStashesCount, StringFormat='{}{0} Stashes'}" FontWeight="Bold" Foreground="#D8B4FE" FontSize="13" />
                                <TextBlock Text="Forgotten" FontSize="10" Foreground="#E9D5FF" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 2. TOOLBAR: Search & Filters -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <ui:TextBox Grid.Column="0"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search repositories by name, path, or branch..."
                            Margin="0,0,12,0"
                            Height="38"
                            FontSize="13"
                            ClearButtonEnabled="True" />

                <!-- Filter Only Dirty Toggle -->
                <ToggleButton Grid.Column="1"
                              IsChecked="{Binding FilterOnlyDirty}"
                              Margin="0,0,12,0"
                              Height="38"
                              Padding="14,0"
                              Background="{Binding FilterOnlyDirty, Converter={x:Null}}"
                              Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ Only Dirty Repos" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <Border Background="#F59E0B" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DirtyReposCount}" FontSize="11" FontWeight="Bold" Foreground="#000000" />
                        </Border>
                    </StackPanel>
                </ToggleButton>

                <!-- Scan Now Button -->
                <ui:Button Grid.Column="2"
                           Command="{Binding ScanCommand}"
                           Appearance="Primary"
                           Height="38"
                           Padding="16,0"
                           Margin="0,0,12,0"
                           IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolToVis}}"
                           Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔄" Margin="0,0,6,0" FontSize="13" />
                        <TextBlock Text="Scan Now" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </ui:Button>

                <!-- Settings Button -->
                <ui:Button Grid.Column="3"
                           Command="{Binding OpenSettingsCommand}"
                           Height="38"
                           Padding="14,0"
                           Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙️" Margin="0,0,6,0" FontSize="13" />
                        <TextBlock Text="Settings" FontSize="13" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- 3. REPOSITORIES LIST -->
            <Grid Grid.Row="2">
                <!-- Repository Cards List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DisplayRepositories}" VirtualizingPanel.IsVirtualizing="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RepoItemViewModel}">
                                <Border Background="#151C2C"
                                        BorderBrush="{Binding IsDirty, Converter={StaticResource DirtyToBrush}}"
                                        BorderThickness="1.5"
                                        CornerRadius="10"
                                        Margin="0,0,0,10"
                                        Padding="16,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Title & Badges -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Path & Commit preview -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Action Buttons -->
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- ROW 1: Repo Title, Branch & Status Badges -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Name & Branch -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />

                                                <!-- Branch Badge -->
                                                <Border Background="#1E293B" CornerRadius="5" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🌿 " FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding CurrentBranch}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Upstream indicator if any -->
                                                <TextBlock Text="{Binding UpstreamBranch, StringFormat='→ {0}'}"
                                                           FontSize="11" Foreground="#64748B"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding UpstreamBranch, Converter={StaticResource StringNotEmptyToVis}}" />
                                            </StackPanel>

                                            <!-- Status Badges -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Clean Badge -->
                                                <Border Style="{StaticResource BadgeBorder}" Background="#064E3B"
                                                        Visibility="{Binding IsClean, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="✓ Clean &amp; Synced" Foreground="#34D399" FontSize="11" FontWeight="Bold" />
                                                </Border>

                                                <!-- Modified / Uncommitted Badge -->
                                                <Border Style="{StaticResource BadgeBorder}" Background="#4C0519"
                                                        Visibility="{Binding ModifiedCount, Converter={StaticResource IntToVis}}">
                                                    <TextBlock Text="{Binding ModifiedCount, StringFormat='⚠️ {0} Modified'}" Foreground="#FB7185" FontSize="11" FontWeight="Bold" />
                                                </Border>

                                                <!-- Untracked Badge -->
                                                <Border Style="{StaticResource BadgeBorder}" Background="#451A03"
                                                        Visibility="{Binding UntrackedCount, Converter={StaticResource IntToVis}}">
                                                    <TextBlock Text="{Binding UntrackedCount, StringFormat='❓ {0} Untracked'}" Foreground="#FBBF24" FontSize="11" FontWeight="Bold" />
                                                </Border>

                                                <!-- Unpushed Commits Badge -->
                                                <Border Style="{StaticResource BadgeBorder}" Background="#083344"
                                                        BorderBrush="#06B6D4" BorderThickness="1"
                                                        Visibility="{Binding AheadCount, Converter={StaticResource IntToVis}}">
                                                    <TextBlock Text="{Binding AheadCount, StringFormat='⬆ {0} Unpushed'}" Foreground="#22D3EE" FontSize="11" FontWeight="Bold" />
                                                </Border>

                                                <!-- Behind Commits Badge -->
                                                <Border Style="{StaticResource BadgeBorder}" Background="#2E1065"
                                                        Visibility="{Binding BehindCount, Converter={StaticResource IntToVis}}">
                                                    <TextBlock Text="{Binding BehindCount, StringFormat='⬇ {0} Behind'}" Foreground="#C084FC" FontSize="11" FontWeight="Bold" />
                                                </Border>

                                                <!-- Stashes Badge -->
                                                <Border Style="{StaticResource BadgeBorder}" Background="#3B0764"
                                                        BorderBrush="#A855F7" BorderThickness="1"
                                                        Visibility="{Binding StashCount, Converter={StaticResource IntToVis}}">
                                                    <TextBlock Text="{Binding StashCount, StringFormat='📦 {0} Stash'}" Foreground="#E879F9" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- ROW 2: Path & Last Commit Preview -->
                                        <Grid Grid.Row="1" Margin="0,6,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Folder Path -->
                                            <TextBlock Grid.Column="0" Text="{Binding Path}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" />

                                            <!-- Last Commit Details -->
                                            <TextBlock Grid.Column="1" Text="{Binding CommitPreview}" FontSize="11" Foreground="#94A3B8" TextAlignment="Right" />
                                        </Grid>

                                        <!-- ROW 3: Action Buttons Bar -->
                                        <Grid Grid.Row="2" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Launcher Buttons -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <!-- Open in VS Code -->
                                                <Button Command="{Binding OpenInVSCodeCommand}" Margin="0,0,6,0" Padding="10,4" Background="#1E293B" Foreground="#E2E8F0" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="💻 " FontSize="12" />
                                                        <TextBlock Text="VS Code" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Open in Rider -->
                                                <Button Command="{Binding OpenInRiderCommand}" Margin="0,0,6,0" Padding="10,4" Background="#1E293B" Foreground="#E2E8F0" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🐎 " FontSize="12" />
                                                        <TextBlock Text="Rider" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Open in Terminal -->
                                                <Button Command="{Binding OpenInTerminalCommand}" Margin="0,0,6,0" Padding="10,4" Background="#1E293B" Foreground="#E2E8F0" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⌨️ " FontSize="12" />
                                                        <TextBlock Text="Terminal" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Open in File Explorer -->
                                                <Button Command="{Binding OpenInExplorerCommand}" Margin="0,0,6,0" Padding="10,4" Background="#1E293B" Foreground="#E2E8F0" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📁 " FontSize="12" />
                                                        <TextBlock Text="Explorer" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Open in Browser (GitHub/GitLab) -->
                                                <Button Command="{Binding OpenInBrowserCommand}"
                                                        Visibility="{Binding HasRemote, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,6,0" Padding="10,4" Background="#1E293B" Foreground="#38BDF8" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🌐 " FontSize="12" />
                                                        <TextBlock Text="Open Web" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Status / Refreshing message -->
                                            <TextBlock Grid.Column="1" Text="{Binding ActionMessage}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                       FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />

                                            <!-- Git Fetch Button -->
                                            <Button Grid.Column="2" Command="{Binding FetchCommand}"
                                                    Padding="10,4" Background="#0F172A" BorderBrush="#334155" Foreground="#94A3B8" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔄 " FontSize="11" />
                                                    <TextBlock Text="Fetch" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- EMPTY STATE: All Clean -->
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12"
                        Margin="40" Padding="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎉" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="All Repositories Clean &amp; Synchronized!" FontSize="20" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" />
                        <TextBlock Text="No uncommitted files, no unpushed commits, and no forgotten stashes." FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,6,0,16" />
                        <TextBlock Text="You are safe to close your laptop or switch machines." FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <ui:Button Command="{Binding ToggleFilterOnlyDirtyCommand}" Padding="16,6" HorizontalAlignment="Center" Appearance="Secondary">
                            <TextBlock Text="View All Repositories" />
                        </ui:Button>
                    </StackPanel>
                </Border>

                <!-- EMPTY STATE: No Repos Discovered -->
                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12"
                        Margin="40" Padding="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasRepositories, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📡" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="No Git Repositories Detected" FontSize="20" FontWeight="Bold" Foreground="#F3F4F6" HorizontalAlignment="Center" />
                        <TextBlock Text="We couldn't find any repositories in your monitored workspace paths." FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,6,0,16" />
                        <ui:Button Command="{Binding OpenSettingsCommand}" Padding="16,8" HorizontalAlignment="Center" Appearance="Primary">
                            <TextBlock Text="Configure Workspace Folders in Settings" FontWeight="SemiBold" />
                        </ui:Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#070A10" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ScanProgressText, StringFormat='  ({0})'}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"
                               Visibility="{Binding ScanProgressText, Converter={StaticResource StringNotEmptyToVis}}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding LastScannedText}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 5. SETTINGS OVERLAY MODAL -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#AA000000"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="12"
                    Width="620" MaxHeight="600" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid DataContext="{Binding SettingsVm}">
                    <Grid.RowDefinitions>
                        <!-- Title -->
                        <RowDefinition Height="Auto" />
                        <!-- Content -->
                        <RowDefinition Height="*" />
                        <!-- Action buttons -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Settings Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="⚙️ RepoRadar Settings" FontSize="20" FontWeight="Bold" Foreground="#F9FAFB" />
                        <TextBlock Text="Configure monitored workspace folders and scanning preferences." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Settings Controls -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Monitored Workspace Folders -->
                            <TextBlock Text="Monitored Workspace Folders:" FontWeight="SemiBold" Foreground="#E5E7EB" FontSize="13" Margin="0,0,0,6" />
                            <ListBox ItemsSource="{Binding WorkspaceFolders}"
                                     SelectedItem="{Binding SelectedFolder}"
                                     Height="120" Background="#1F2937" BorderBrush="#374151" Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Command="{Binding AddFolderCommand}" Margin="0,0,8,0" Padding="12,4">
                                    <TextBlock Text="➕ Add Folder..." />
                                </Button>
                                <Button Command="{Binding RemoveSelectedFolderCommand}" Padding="12,4" IsEnabled="{Binding SelectedFolder, Converter={StaticResource StringNotEmptyToVis}}">
                                    <TextBlock Text="🗑️ Remove" />
                                </Button>
                            </StackPanel>

                            <!-- Scan Interval -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Auto-Scan Interval" FontWeight="SemiBold" Foreground="#E5E7EB" FontSize="13" />
                                    <TextBlock Text="Frequency of periodic background Git checks" FontSize="11" Foreground="#9CA3AF" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableIntervals}" SelectedItem="{Binding ScanIntervalMinutes}" Width="140">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='{}{0} Minutes'}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- Preferred Editor -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Preferred Code Editor" FontWeight="SemiBold" Foreground="#E5E7EB" FontSize="13" />
                                    <TextBlock Text="Default editor launched when clicking repositories in tray menu" FontSize="11" Foreground="#9CA3AF" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableEditors}" SelectedItem="{Binding PreferredEditor}" Width="140" />
                            </Grid>

                            <!-- End-of-Day Alert -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="End-of-Day Workday Alert" FontWeight="SemiBold" Foreground="#E5E7EB" FontSize="13" />
                                    <TextBlock Text="Alert via tray notification before shutdown if uncommitted/unpushed work remains" FontSize="11" Foreground="#9CA3AF" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding NotifyOnDirtyBeforeEndOfDay}" />
                            </Grid>

                            <!-- Alert Hour -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="End-of-Day Target Hour" FontWeight="SemiBold" Foreground="#E5E7EB" FontSize="13" />
                                    <TextBlock Text="Hour of day (24h format, e.g. 18 for 6:00 PM)" FontSize="11" Foreground="#9CA3AF" />
                                </StackPanel>
                                <ui:TextBox Grid.Column="1" Text="{Binding EndOfDayHour, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            </Grid>

                            <!-- Close to Tray -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Minimize to System Tray" FontWeight="SemiBold" Foreground="#E5E7EB" FontSize="13" />
                                    <TextBlock Text="Keep monitoring in background when window is closed" FontSize="11" Foreground="#9CA3AF" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding CloseToTray}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Command="{Binding SaveSettingsCommand}" Appearance="Primary" Margin="0,0,10,0" Padding="18,6">
                            <TextBlock Text="Save &amp; Apply" FontWeight="SemiBold" />
                        </ui:Button>
                        <Button Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Padding="14,6">
                            <TextBlock Text="Close" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
