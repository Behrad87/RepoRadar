<ui:FluentWindow x:Class="RepoRadar.App.Views.DonationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Support RepoRadar"
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/icon.ico">

    <Grid Background="#0B0F19">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="RepoRadar — Support &amp; Donation" ShowMaximize="False" Icon="pack://application:,,,/Assets/icon.png" />

        <Grid Grid.Row="1" Margin="24,12,24,20">
            <Grid.RowDefinitions>
                <!-- Hero Header -->
                <RowDefinition Height="Auto" />
                <!-- Value Anchor Card -->
                <RowDefinition Height="Auto" />
                <!-- Intelligent Pitch -->
                <RowDefinition Height="Auto" />
                <!-- Support Buttons -->
                <RowDefinition Height="*" />
                <!-- Close Button -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Hero Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Border Width="56" Height="56" CornerRadius="28" Background="#1E293B" BorderBrush="#FF5E7E" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <ui:SymbolIcon Symbol="Heart24" FontSize="28" Foreground="#FF5E7E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Support RepoRadar" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                <TextBlock Text="100% Free &amp; Open-Source • Built for Developers" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>

            <!-- 2. Value Anchor Card -->
            <Border Grid.Row="1" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#064E3B" VerticalAlignment="Center" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="22" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Never Lose Uncommitted Code Again" FontWeight="Bold" Foreground="#E2E8F0" FontSize="13" />
                        <TextBlock Text="RepoRadar quietly audits all your repositories before daily shutdown, saving you hours of lost work and merge friction."
                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Pitch Text -->
            <TextBlock Grid.Row="2"
                       Text="RepoRadar is free without ads, analytics trackers, or paywalls. If this tool keeps your dev workspace clean and saves your peace of mind, consider supporting its maintenance!"
                       TextWrapping="Wrap" FontSize="12" Foreground="#94A3B8" TextAlignment="Center" Margin="0,0,0,16" LineHeight="18" />

            <!-- 4. Support / Donation Option Buttons -->
            <StackPanel Grid.Row="3" VerticalAlignment="Center">
                <!-- Row with Ko-fi and Reymit -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Ko-fi -->
                    <ui:Button Grid.Column="0" Click="OnKofiClicked" Appearance="Secondary" Margin="0,0,5,0" Padding="12,10" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="DrinkCoffee24" Margin="0,0,8,0" Foreground="#FFA500" />
                            <TextBlock Text="Tip on Ko-fi ($3)" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Reymit (Shetab) -->
                    <ui:Button Grid.Column="1" Click="OnReymitClicked" Appearance="Secondary" Margin="5,0,0,0" Padding="12,10" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Money24" Margin="0,0,8,0" Foreground="#10B981" />
                            <TextBlock Text="ری‌میت (شتاب)" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </ui:Button>
                </Grid>

                <!-- GitHub Sponsors (Wall of Fame) -->
                <ui:Button Click="OnSponsorClicked" Appearance="Primary" Padding="14,10" Margin="0,0,0,10" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Heart24" Margin="0,0,8,0" Foreground="#FF5E7E" />
                        <TextBlock Text="Sponsor on GitHub (Wall of Fame)" FontWeight="Bold" FontSize="13" />
                    </StackPanel>
                </ui:Button>

                <!-- Star on GitHub -->
                <ui:Button Click="OnStarClicked" Appearance="Secondary" Padding="12,8" Margin="0,0,0,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Star24" Margin="0,0,8,0" Foreground="#FFD700" />
                        <TextBlock Text="Star on GitHub (Free &amp; Appreciated)" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>

            <!-- 5. Close Button -->
            <ui:Button Grid.Row="4" Click="OnCloseClicked" Appearance="Transparent"
                       HorizontalAlignment="Center" Content="Close &amp; Keep Coding" Margin="0,8,0,0" Cursor="Hand" />
        </Grid>
    </Grid>
</ui:FluentWindow>
